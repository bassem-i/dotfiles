# Devices folder contains device-specific dotfiles
devices
# Generated folder contains device-specific autogenerated config
generated
# Tmux plugins can be installed using Ctrl+A then Shift+I
tmux/.config/tmux/plugins
# Lazygit state
lazygit/.config/lazygit/state.yml

# Global gitignore blanket-ignores ".claude", but this repo intentionally
# tracks a claude/.claude package to manage ~/.claude/settings.json via stow
!/claude/.claude/
!/claude/.claude/**
